<?xml version="1.0" encoding="UTF-8"?>
<web-app version="6.0" xmlns="https://jakarta.ee/xml/ns/jakartaee" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="https://jakarta.ee/xml/ns/jakartaee https://jakarta.ee/xml/ns/jakartaee/web-app_6_0.xsd">
    <servlet>
        <servlet-name>LoginRedirectServlet</servlet-name>
        <servlet-class>Login_PK.LoginRedirectServlet</servlet-class>
    </servlet>
    <servlet>
        <servlet-name>UploadCDRServlet</servlet-name>
        <servlet-class>CDR_PK.UploadCDRServlet</servlet-class>
    </servlet>
    <servlet>
        <servlet-name>SubscribersMainPageServlet</servlet-name>
        <servlet-class>Subscribers_PK.SubscribersMainPageServlet</servlet-class>
    </servlet>
    <servlet>
        <servlet-name>GetAllPlanServlet</servlet-name>
        <servlet-class>Plans_PK.GetAllPlanServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>LoginRedirectServlet</servlet-name>
        <url-pattern>/LoginRedirectServlet</url-pattern>
    </servlet-mapping>
    <servlet-mapping>
        <servlet-name>UploadCDRServlet</servlet-name>
        <url-pattern>/UploadCDRServlet</url-pattern>
    </servlet-mapping>
    <servlet-mapping>
        <servlet-name>SubscribersMainPageServlet</servlet-name>
        <url-pattern>/SubscribersMainPageServlet</url-pattern>
    </servlet-mapping>
    <servlet-mapping>
        <servlet-name>GetAllPlanServlet</servlet-name>
        <url-pattern>/GetAllPlanServlet</url-pattern>
    </servlet-mapping>
    <session-config>
        <session-timeout>
            30
        </session-timeout>
    </session-config>
</web-app>
